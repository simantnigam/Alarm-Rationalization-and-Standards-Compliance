# =============================================================================
# Alarm Rationalization and Standards Compliance Copilot — environment template
# Copy to .env and fill in real values. Never commit .env. See README §Configuration
# and docs/known-limitations.md for which of these are demo defaults vs production
# values (marked below).
# =============================================================================

# --- Alarm Management API simulator (services/alarm_api_simulator) ---------------
ALARM_API_BASE_URL=http://alarm-api:8000
ALARM_API_TOKEN=demo-token
SIM_PROFILE=realistic          # realistic | compact | golden
SIM_SEED=20260812
SIM_NOW=                        # empty = now(); set an ISO date to pin the demo clock

# --- Postgres (two logical databases, two roles — see 00-decisions.md D-05) ------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace-me
# alarmdb — owned by alarmapi_rw, used ONLY by the simulator and the MCP server's
# connector. copilot_rw has NO grant on this database.
ALARMDB_NAME=alarmdb
ALARMDB_USER=alarmapi_rw
ALARMDB_PASSWORD=replace-me
# copilot — owned by copilot_rw, used ONLY by the copilot backend (LangGraph
# checkpoints, rationalization_decisions). No grant on alarmdb.
COPILOT_DB_NAME=copilot
COPILOT_DB_USER=copilot_rw
COPILOT_DB_PASSWORD=replace-me

# --- MCP server: alarm-management (mcp-servers/alarm-management) -----------------
MCP_TRANSPORT=http              # stdio | http
MCP_ALARM_URL=http://alarm-mcp:9000/mcp
MCP_ALARM_HOST=0.0.0.0
MCP_ALARM_PORT=9000
CONFIRMATION_TOKEN_SECRET=replace-me     # signs preview_rationalization_decision tokens
CONFIRMATION_TOKEN_TTL_SECONDS=600

# --- Copilot backend (apps/backend) -----------------------------------------------
COPILOT_API_HOST=0.0.0.0
COPILOT_API_PORT=8080
COPILOT_API_KEY=replace-me      # required X-API-Key on every route except /health
LLM_MAX_CALLS_PER_CONVERSATION=8

# LLM provider — Anthropic is always the default (see 00-decisions.md D-06b).
LLM_PROVIDER=anthropic          # anthropic | openai | stub
ANTHROPIC_API_KEY=replace-me
LLM_ANTHROPIC_PLANNER=claude-haiku-4-5
LLM_ANTHROPIC_SYNTHESIZER=claude-sonnet-5

# OpenAI is an alternate provider, activated only by an explicit LLM_PROVIDER=openai
# change. $5 total budget — see D-06b guardrails. Tests never call this live.
OPENAI_API_KEY=replace-me
LLM_OPENAI_CHEAP=gpt-5-mini
LLM_OPENAI_FRONTIER=gpt-5

LANGCHAIN_TRACING_V2=false      # explicitly disabled — no third-party egress of alarm data

# --- RAG / retrieval (rag/) --------------------------------------------------------
DOCUMENT_PATH=./rag/documents
VECTOR_STORE_URL=http://qdrant:6333
QDRANT_COLLECTION_ALIAS=policy_chunks
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAG_RERANK_ENABLED=true
RAG_MIN_SCORE=0.35
RAG_MIN_CITATIONS=1
# Demo default: true (bare `docker compose up --build` must yield a working stack).
# Production value: false — the batch job (`--profile batch run rag-ingest`) owns
# the index lifecycle. See known-limitations.md L-18.
RAG_BOOTSTRAP_ON_START=true
FASTEMBED_CACHE_PATH=/opt/fastembed_cache
HF_HUB_OFFLINE=1

# --- GUI (apps/frontend) ------------------------------------------------------------
COPILOT_API_URL=http://copilot-api:8080
GUI_TITLE=Alarm Rationalization Copilot
GUI_MAX_ROWS=200
GUI_THEME=light

# --- Ticketing (not implemented — placeholder retained per guidelines §10 sample) --
TICKETING_API_URL=replace-me

# --- Observability -------------------------------------------------------------------
LOG_LEVEL=INFO
